# =============================================================================
# GuardianAI — Environment Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials:
#   cp .env.example .env
# =============================================================================

# --- Backend & AI LLM Services ---
# Groq Cloud API key for running llama-3.3-70b-versatile
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Local Ollama endpoint for nomic-embed-text (768-dim embeddings)
OLLAMA_HOST=http://localhost:11434

# --- Vector Database (Qdrant) ---
# Qdrant vector database connection settings
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Relational Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/guardian_db

# --- Security & Authentication ---
# Cryptographic secret used to sign and verify responder session tokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256

# --- Server Ports & Host Binding ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend Client Endpoints ---
# Points the React frontend to the FastAPI gateway and WebSocket bus
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/dashboard
